<%- include("partials/_header") %>

<div class="main">
  <div class="label-title">
    <a href="/about#how-to-play">How to play</a>
  </div>

  <div class="label-title">
    <h4>PREVIOUS SENTENCE:</h4>

      <p name="prevSent" class="last-sentence">
        <%= toRender %>
      </p>

  </div>

  <div class="box">
    <form id="form" action="/" method="POST">
      <div class="label-title">
        <h4>YOUR SENTENCE:</h4>
      </div>
      <%- include("partials/_sentence_input", { required: true }) %>
      <br />
      <%- include("partials/_email_prompt") %>
      <br>
      <p class="sentences-countdown">
        Sentences left in the story: <%= sencentesLeft %> / <%= sentenceLimit %>
      </p>
      <input type="image" src="/images/send_button.png" class="img-submit" alt="Image Submit, Send silliness" />
    </form>

    <%- include("partials/_menu") %>

  </div>
</div>
</div>
<script>
  $("#checkbox").change(function () {
    $("#email-input").toggle("slow", "linear", function () { });
  });
</script>
</body>

</html>
