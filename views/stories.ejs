<%- include("partials/_header", {
  headerLogo: {
    src: "/images/silly_archive.png",
    alt: "Silly Archive",
    href: null,
    showHomeLink: true,
  },
}) %>

<div class="main">
  <% if (stories.length === 0) { %>
  <div class="stories-empty">
    <p>There are no stories yet.</p>
  </div>
  <% } %>

  <% let count = 0 %>
  <% stories.forEach((story) => { %>

  <div class="label-title">
    <h4>Story #<%= count += 1 %></h4>
  </div>
  <div class="stories-text">
    <% story.parts.forEach((part) =>{ %>
    <% if ((part.id) %2 === 0){ %>
    <p class="even-s"><%= part.text %></p>
    <% } else { %>
    <p class="odd-s"><%= part.text %></p>
    <% } %>
    <% }) %>
  </div>
  <img class="draw-line" src="images/Line.png " alt="separating line" />

  <% }) %>

  <%- include("partials/_menu") %>
</div>
</body>

</html>
